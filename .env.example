# Public example values only. Keep real values in /etc/homelab-ai/homelab.env
# or in an untracked .env file on the host.

PROJECT_ROOT=/opt/homelab-ai
OLLAMA_DATA_DIR=/srv/homelab-ai/ollama
COMFYUI_SOURCE_DIR=/srv/homelab-ai/comfyui

OPEN_WEBUI_HOSTNAME=ai.example.com
COMFYUI_HOSTNAME=media.example.com
N8N_HOSTNAME=flow.example.com
CLOUDFLARED_CONFIG=/etc/cloudflared/config.yml

TZ=Etc/UTC

# Obrigatório para o serviço searxng (profile optional); gere com: openssl rand -hex 32
SEARXNG_SECRET=replace-with-random-hex

# Opcional — pipeline agents/youtube-etl (n8n). Valores reais fora do repo.
# HOMELAB_ROOT: raiz do clone deste repositório (usado pelo volume de relatórios do n8n)
HOMELAB_ROOT=/opt/homelab-ai
YOUTUBE_API_KEY=changeme
RAPIDAPI_KEY=changeme
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=0
