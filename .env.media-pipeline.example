# Copie para .env e use caminhos absolutos. Este arquivo não contém segredos.
HOMELAB_ROOT=/home/user/media-workspace/homelab-ai
HOMELAB_RUNTIME_DIR=/home/user/media-workspace/homelab-runtime
COMFYUI_SOURCE_DIR=/home/user/media-workspace/homelab-runtime/comfyui
OLLAMA_DATA_DIR=/home/user/media-workspace/homelab-runtime/ollama
TZ=Etc/UTC
# Opcional — DeepSeek Harness (profile harness). Workspace isolado do checkout.
DSH_PUBLIC_HOSTNAME=dsh.example.com
DSH_CLOUDFLARE_ENABLED=false
DSH_WORKSPACE_DIR=/srv/homelab-ai/dsh-workspaces
# Obrigatório para o serviço searxng (profile optional); gere com: openssl rand -hex 32
SEARXNG_SECRET=replace-with-random-hex
# Opcional — pipeline agents/youtube-etl (n8n). Valores reais fora do repo.
# Transcrição usa yt-dlp (dentro do container n8n), sem chave/cota própria.
YOUTUBE_API_KEY=changeme
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=0
