[Unit]
Description=YouTube ETL — Mercado Automotivo (executa e aguarda o workflow n8n)
# Dá tempo do Docker subir n8n/Ollama quando o timer dispara logo após o boot
# (Persistent=true executa runs perdidos na primeira oportunidade).

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 60
ExecStart=%h/homelab-ai/agents/youtube-etl/run.sh
WorkingDirectory=%h/homelab-ai/agents/youtube-etl
# O webhook agora responde somente no fim do workflow. O teto cobre até 60
# vídeos (20 canais x 3), sem encerrar uma rodada válida no meio.
TimeoutStartSec=4h10min
