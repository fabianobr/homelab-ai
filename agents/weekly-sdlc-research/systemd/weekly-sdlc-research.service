[Unit]
Description=Weekly SDLC research agent (novidades de LLM/SDLC agêntico)
# Dá tempo do Docker subir Ollama/SearXNG quando o timer dispara logo após o boot
# (Persistent=true executa runs perdidos na primeira oportunidade).

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 60
ExecStart=%h/homelab-ai/agents/weekly-sdlc-research/run-with-notify.sh
WorkingDirectory=%h/homelab-ai/agents/weekly-sdlc-research
TimeoutStartSec=30min
