{
  "_comment": "Minimal known-good ComfyUI API workflow for infra/scripts/comfy-smoke.sh. SD1.5 at 64x64 / 2 steps: self-contained (bundled CLIP+VAE), exercises real CUDA kernels, finishes in a few seconds. Override with COMFY_SMOKE_WORKFLOW / COMFY_SMOKE_CKPT if this checkpoint is absent.",
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "v1-5-pruned-emaonly-fp16 (2).safetensors" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "a red apple on a table", "clip": ["1", 1] } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
  "4": { "class_type": "EmptyLatentImage", "inputs": { "width": 64, "height": 64, "batch_size": 1 } },
  "5": { "class_type": "KSampler", "inputs": { "model": ["1", 0], "seed": 1, "steps": 2, "cfg": 7.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0], "denoise": 1.0 } },
  "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
  "7": { "class_type": "SaveImage", "inputs": { "images": ["6", 0], "filename_prefix": "comfy-smoke" } }
}
